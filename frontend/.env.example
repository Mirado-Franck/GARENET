# ==========================================
# GARENET — Frontend (exemple de configuration)
# Copier ce fichier vers .env puis compléter :
#   cp .env.example .env
# ==========================================

# URL du serveur backend (racine, SANS le "/api").
#
# 📱 Sur téléphone : adresse IP de VOTRE machine sur le Wi-Fi + port
#    (le téléphone et le backend doivent être sur le même réseau) :
#    EXPO_PUBLIC_API_URL=http://192.168.1.100:3000
#
# 🖥️  En navigateur (npm run web) :
#    EXPO_PUBLIC_API_URL=http://localhost:3000
#
# 🤖 Sur émulateur Android (le "localhost" de l'émulateur pointe sur lui-même) :
#    EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

EXPO_PUBLIC_API_URL=http://localhost:3000
